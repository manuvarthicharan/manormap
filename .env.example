# ==============================================================================
# REAL ESTATE DISCOVERY RADAR — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Supabase Cloud Configuration (PostgreSQL Database + Google Auth)
# Obtain from: https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 2. Render Server API Base URL (For Frontend Cloudflare Deployment)
# When frontend is on Cloudflare and backend is on Render:
# VITE_API_BASE_URL=https://your-service-name.onrender.com
# Leave blank for local development or when proxying through Cloudflare
VITE_API_BASE_URL=

# 3. AI Engine OpenRouter API (Render Server-Side Environment Variable)
# Obtain from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# 4. Standalone Render Server Port & CORS
PORT=3001
CORS_ORIGIN=*
